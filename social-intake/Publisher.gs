/**
 * KCAA Social Publisher — part of the Apps Script project "SocialDraftWriter" (runs AS info@kcaa.ca).
 * Add as a file next to DraftWriter.gs (it uses that file's Firestore helpers and settings).
 *
 * Posts APPROVED drafts to Instagram. Nothing is posted unless a person approved it on the Hub's
 * Post Review page first. Rules enforced here, in code:
 *   - at most DAILY_POST_CAP posts per Toronto day; the rest wait, oldest approval first
 *   - JPEG photos only (single photo, or a carousel of 2-10). Anything else, including video,
 *     is marked "publish_failed" with a clear reason so a person posts it by hand
 *   - photos are made public ONLY while Instagram downloads them, then put back as they were
 *   - the post goes to the account the token belongs to, and only if that matches IG_USER_ID
 *   - a draft is claimed ("publishing") before anything is sent, and never retried automatically
 *     after an Instagram error, so a failure cannot turn into a double post
 *
 * Script properties (Project Settings > Script properties; never in code or the repo):
 *   IG_ACCESS_TOKEN    long-lived Instagram token (refreshed weekly by refreshIgToken)
 *   IG_USER_ID         numeric Instagram account id the posts go to
 *   IG_USERNAME        (optional) username that account must have, as a second safety check
 *   PUBLISH_PAUSED     set to "true" to stop publishing without touching triggers
 *
 * Functions to run by hand:
 *   publisherStatus    - read-only check of account, token age, queue and today's count
 *   publishApproved    - one publish pass (this is what the 15-minute trigger runs)
 *   setupPublisher     - installs the triggers (publish every 15 min, token refresh weekly)
 *   refreshIgToken     - refreshes the token now
 */

var PUB = {
  API: 'https://graph.instagram.com/v22.0',
  DAILY_POST_CAP: 2,
  MAX_PER_RUN: 2,
  MAX_IMAGE_BYTES: 8 * 1024 * 1024,   // Instagram's limit for feed photos
  MAX_RUN_MS: 4.5 * 60 * 1000,        // Apps Script stops a run at 6 minutes
  TOKEN_MAX_AGE_DAYS: 50              // warn well before the 60-day expiry
};

/** Run once by hand when ready to go live. Safe to run again. */
function setupPublisher() {
  var have = {};
  ScriptApp.getProjectTriggers().forEach(function (t) { have[t.getHandlerFunction()] = true; });
  if (!have.publishApproved) ScriptApp.newTrigger('publishApproved').timeBased().everyMinutes(15).create();
  if (!have.refreshIgToken) ScriptApp.newTrigger('refreshIgToken').timeBased().everyDays(7).create();
  console.log('Publisher triggers installed: publishApproved every 15 min, refreshIgToken weekly.');
}

/** Read-only: shows what the publisher would do. */
function publisherStatus() {
  var props = PropertiesService.getScriptProperties();
  var me = pubCheckAccount_();
  console.log('Posting to: @' + me.username + ' (id ' + me.user_id + ')');
  console.log('Paused: ' + (props.getProperty('PUBLISH_PAUSED') === 'true' ? 'YES' : 'no'));
  var refreshed = props.getProperty('IG_TOKEN_REFRESHED_AT');
  console.log('Token last refreshed: ' + (refreshed || 'never by this script (generated by hand)'));
  if (refreshed && (Date.now() - new Date(refreshed).getTime()) > PUB.TOKEN_MAX_AGE_DAYS * 86400000) {
    console.log('WARNING: token refresh is overdue. Run refreshIgToken now.');
  }
  console.log('Approved and waiting: ' + pubListApproved_().length);
  console.log('Published today: ' + pubCountPublishedToday_() + ' of ' + PUB.DAILY_POST_CAP);
}

/** One publish pass. Trigger target. */
function publishApproved() {
  if (PropertiesService.getScriptProperties().getProperty('PUBLISH_PAUSED') === 'true') {
    console.log('Publishing is paused (PUBLISH_PAUSED).');
    return;
  }
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) {
    console.log('Another publish run is active; skipping.');
    return;
  }
  try {
    pubRun_();
  } finally {
    lock.releaseLock();
  }
}

function pubRun_() {
  var started = Date.now();
  pubCheckAccount_(); // throws if the token is not for the expected account

  // Under the lock, any draft still marked "publishing" was left by a run that died mid-way.
  pubListByStatus_('publishing').forEach(function (row) {
    pubMarkFailed_(row.id, 'Publishing was interrupted. Check the Instagram account before retrying: it may have posted.');
  });

  var room = Math.min(PUB.DAILY_POST_CAP - pubCountPublishedToday_(), PUB.MAX_PER_RUN);
  if (room <= 0) {
    console.log('Daily cap of ' + PUB.DAILY_POST_CAP + ' posts reached; approved drafts wait until tomorrow.');
    return;
  }
  var queue = pubListApproved_();
  if (!queue.length) {
    console.log('Nothing approved is waiting.');
    return;
  }
  for (var i = 0; i < queue.length && i < room; i++) {
    if (Date.now() - started > PUB.MAX_RUN_MS) {
      console.log('Out of time for this run; the rest wait for the next one.');
      break;
    }
    pubPublishOne_(queue[i].id, queue[i].d, started);
  }
}

/** Publish one approved draft. Every outcome is written back to the draft. */
function pubPublishOne_(id, d, started) {
  var plan = pubPlanMedia_(d);
  if (plan.error) {
    pubMarkFailed_(id, plan.error);
    return;
  }

  firestorePatch_(id, { status: 'publishing', publishStartedAt: new Date().toISOString() }); // claim
  var uid = pubUserId_();
  var shared = [];
  var publishCalled = false;
  try {
    plan.items.forEach(function (it) {
      shared.push({ file: it.file, access: it.file.getSharingAccess(), perm: it.file.getSharingPermission() });
      it.file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW); // temporary
    });

    var creationId = pubCreateContainer_(uid, plan.items, d.caption, started);
    publishCalled = true;
    var out = pubPost_('/' + uid + '/media_publish', { creation_id: creationId });

    var permalink = '';
    try { permalink = pubGet_('/' + out.id + '?fields=permalink').permalink || ''; } catch (e) { /* the post is live either way */ }
    firestorePatch_(id, { status: 'published', publishedAt: new Date().toISOString(), igMediaId: String(out.id), igPermalink: permalink });
    console.log('Published draft ' + id + ': ' + (permalink || out.id));
  } catch (e) {
    pubMarkFailed_(id, String(e.message || e) + (publishCalled ? ' (the final publish call failed: check Instagram, the post may be live)' : ' (nothing was posted)'));
  } finally {
    shared.forEach(function (s) {
      try {
        s.file.setSharing(s.access, s.perm);
      } catch (e) {
        console.error('COULD NOT RESTORE SHARING on ' + s.file.getName() + ': set it back to private by hand. ' + e);
      }
    });
  }
}

/** Decide whether every photo in the draft can be posted automatically. */
function pubPlanMedia_(d) {
  var urls = Array.isArray(d.mediaUrls) ? d.mediaUrls : [];
  var ids = urls.map(pubDriveId_).filter(Boolean);
  if (!ids.length) return { error: 'Needs manual posting: the draft has no usable Google Drive photo links.' };
  if (ids.length > DW.MAX_MEDIA) return { error: 'Needs manual posting: more than ' + DW.MAX_MEDIA + ' photos.' };
  var caption = typeof d.caption === 'string' ? d.caption.trim() : '';
  if (!caption) return { error: 'The draft has no caption.' };

  var items = [];
  for (var i = 0; i < ids.length; i++) {
    var file;
    try {
      file = DriveApp.getFileById(ids[i]);
    } catch (e) {
      return { error: 'Needs manual posting: could not open photo ' + (i + 1) + ' in Drive.' };
    }
    var mime = file.getMimeType();
    if (mime !== 'image/jpeg') {
      return { error: 'Needs manual posting: ' + file.getName() + ' is ' + mime + '. Automatic posting handles JPEG photos only; videos and other formats are posted by hand.' };
    }
    if (file.getSize() > PUB.MAX_IMAGE_BYTES) {
      return { error: 'Needs manual posting: ' + file.getName() + ' is over Instagram\'s 8 MB photo limit.' };
    }
    items.push({ id: ids[i], file: file });
  }
  return { items: items };
}

function pubCreateContainer_(uid, items, caption, started) {
  function url(it) { return 'https://drive.google.com/uc?export=download&id=' + it.id; }
  caption = caption.trim().slice(0, DW.MAX_CAPTION);

  if (items.length === 1) {
    var single = pubPost_('/' + uid + '/media', { image_url: url(items[0]), caption: caption });
    pubWait_(single.id, started);
    return single.id;
  }
  var children = items.map(function (it) {
    var c = pubPost_('/' + uid + '/media', { image_url: url(it), is_carousel_item: 'true' });
    pubWait_(c.id, started);
    return c.id;
  });
  var carousel = pubPost_('/' + uid + '/media', { media_type: 'CAROUSEL', children: children.join(','), caption: caption });
  pubWait_(carousel.id, started);
  return carousel.id;
}

/** Instagram prepares each container asynchronously; wait until FINISHED. */
function pubWait_(containerId, started) {
  for (var n = 0; n < 20; n++) {
    if (Date.now() - started > PUB.MAX_RUN_MS) throw new Error('Timed out waiting for Instagram');
    var s = pubGet_('/' + containerId + '?fields=status_code,status');
    if (s.status_code === 'FINISHED') return;
    if (s.status_code === 'ERROR' || s.status_code === 'EXPIRED') {
      throw new Error('Instagram could not process the photo (' + s.status_code + (s.status ? ': ' + s.status : '') + ')');
    }
    Utilities.sleep(3000);
  }
  throw new Error('Timed out waiting for Instagram');
}

function pubMarkFailed_(id, message) {
  console.error('Draft ' + id + ' not published: ' + message);
  firestorePatch_(id, { status: 'publish_failed', publishError: String(message).slice(0, 300), failedAt: new Date().toISOString() });
}

// ---- token ------------------------------------------------------------------

/** Long-lived Instagram tokens last 60 days; refreshing extends them. Runs weekly. */
function refreshIgToken() {
  var props = PropertiesService.getScriptProperties();
  var res;
  try {
    res = UrlFetchApp.fetch('https://graph.instagram.com/refresh_access_token?grant_type=ig_refresh_token&access_token=' +
      encodeURIComponent(pubToken_()), { muteHttpExceptions: true });
  } catch (e) {
    throw new Error('Token refresh request failed.'); // generic on purpose: the URL contains the token
  }
  var body = {};
  try { body = JSON.parse(res.getContentText() || '{}'); } catch (e) { /* handled below */ }
  if (res.getResponseCode() !== 200 || !body.access_token) {
    var err = body.error || {};
    throw new Error('Token refresh failed: ' + (err.message || 'HTTP ' + res.getResponseCode()));
  }
  props.setProperty('IG_ACCESS_TOKEN', body.access_token);
  props.setProperty('IG_TOKEN_REFRESHED_AT', new Date().toISOString());
  console.log('Instagram token refreshed; valid for about ' + Math.round((body.expires_in || 0) / 86400) + ' more days.');
}

// ---- Instagram calls --------------------------------------------------------

function pubToken_() {
  var t = PropertiesService.getScriptProperties().getProperty('IG_ACCESS_TOKEN');
  if (!t) throw new Error('Add the script property IG_ACCESS_TOKEN first.');
  return t;
}

function pubUserId_() {
  var id = PropertiesService.getScriptProperties().getProperty('IG_USER_ID');
  if (!id) throw new Error('Add the script property IG_USER_ID first.');
  return id;
}

/** The token must belong to the account we think we are posting to. */
function pubCheckAccount_() {
  var props = PropertiesService.getScriptProperties();
  var me = pubGet_('/me?fields=user_id,username');
  if (String(me.user_id) !== String(pubUserId_())) {
    throw new Error('The token is for @' + me.username + ' (id ' + me.user_id + '), not IG_USER_ID ' + pubUserId_() + '. Refusing to post.');
  }
  var expected = props.getProperty('IG_USERNAME');
  if (expected && me.username !== expected) {
    throw new Error('The token is for @' + me.username + ', not @' + expected + '. Refusing to post.');
  }
  return me;
}

function pubGet_(path) {
  return pubFetch_(PUB.API + path, { method: 'get' });
}

function pubPost_(path, form) {
  return pubFetch_(PUB.API + path, { method: 'post', payload: form });
}

/** The token goes in a header, never in the URL, so it cannot show up in logs or errors. */
function pubFetch_(url, options) {
  options.muteHttpExceptions = true;
  options.headers = { Authorization: 'Bearer ' + pubToken_() };
  var res = UrlFetchApp.fetch(url, options);
  var body = {};
  try { body = JSON.parse(res.getContentText() || '{}'); } catch (e) { /* non-JSON error page */ }
  if (res.getResponseCode() < 200 || res.getResponseCode() >= 300 || body.error) {
    var err = body.error || {};
    throw new Error('Instagram ' + res.getResponseCode() + ': ' + (err.message || String(res.getContentText()).slice(0, 200)) +
      (err.code ? ' (code ' + err.code + (err.error_subcode ? '/' + err.error_subcode : '') + ')' : ''));
  }
  return body;
}

// ---- Firestore queries ------------------------------------------------------

function pubQuery_(where) {
  var rows = fsFetch_(fsBase_() + ':runQuery', {
    method: 'post',
    contentType: 'application/json',
    payload: JSON.stringify({ structuredQuery: { from: [{ collectionId: 'social_drafts' }], where: where, limit: 50 } })
  });
  return (rows || []).filter(function (r) { return r.document; }).map(function (r) {
    return { id: docId_(r.document), d: fromFields_(r.document.fields || {}) };
  });
}

function pubListByStatus_(status) {
  return pubQuery_({ fieldFilter: { field: { fieldPath: 'status' }, op: 'EQUAL', value: { stringValue: status } } });
}

/** Approved drafts, oldest approval first. */
function pubListApproved_() {
  return pubListByStatus_('approved').sort(function (a, b) {
    return String(a.d.decidedAt || a.d.createdAt).localeCompare(String(b.d.decidedAt || b.d.createdAt));
  });
}

function pubCountPublishedToday_() {
  var startUtc = new Date(Utilities.formatDate(new Date(), DW.TIMEZONE, 'yyyy/MM/dd') + ' 00:00:00').toISOString();
  return pubQuery_({ fieldFilter: { field: { fieldPath: 'publishedAt' }, op: 'GREATER_THAN_OR_EQUAL', value: { stringValue: startUtc } } })
    .filter(function (r) { return r.d.status === 'published'; }).length;
}

function pubDriveId_(url) {
  var m = /\/d\/([\w-]+)/.exec(url || '') || /[?&]id=([\w-]+)/.exec(url || '');
  return m ? m[1] : null;
}

rules_version = '2';

// KCAA Hub — Firestore security rules (the whole file).
// Paste this ENTIRE file into Firebase console → Firestore Database → Rules → Publish.
// Every collection below requires an @kcaa.ca Google sign-in (see isAdmin()),
// except the parent-facing check-in paths, which stay open on purpose.
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone signed in with an @kcaa.ca Google account. Domain-based, not a
    // per-person list — matches gate.js, which only lets @kcaa.ca accounts
    // past the Hub's sign-in screen in the first place.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@kcaa[.]ca$');
    }

    // A narrower list, just for the Admin section (the edit log). Add an
    // email here to give someone access — keep this in sync with
    // SUPER_ADMINS in nav.js, which is what decides whether to even show
    // the "Admin" link (this rule is the real enforcement either way).
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['info@kcaa.ca'];
    }

    // Only the people who may approve Instagram drafts (Miriam Panahi, main
    // chair; Caitlin Kim, backup; info@kcaa.ca, Hub admin). Keep in sync with the "Post Review" link
    // visibility in nav.js (SOCIAL_APPROVERS) — this rule is the real gate.
    function isSocialApprover() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['miriam.panahi@kcaa.ca', 'caitlin.kim@kcaa.ca', 'info@kcaa.ca'];
    }

    // ---- Live Tools: any signed-in board member ----
    match /schools/{id}         { allow read, write: if isAdmin(); }
    match /meeting_minutes/{id} { allow read, write: if isAdmin(); }
    match /coffee_pickup/{id}   { allow read, write: if isAdmin(); }

    // ---- Social Media Agent: Instagram drafts ----
    // The agent creates/redrafts/publishes with the Admin SDK (bypasses
    // rules). Approvers can read, add a hand-written pending draft, and
    // update ONLY the decision fields — never the caption/media, and never
    // mark something "published" themselves.
    match /social_drafts/{id} {
      allow read: if isSocialApprover();
      allow create: if isSocialApprover() && request.resource.data.status == 'pending';
      allow update: if isSocialApprover()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'feedback', 'decidedBy', 'decidedAt'])
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'changes_requested', 'escalated', 'rejected'];
    }

    // Known senders for social@kcaa.ca intake. Doc id = lowercased sender
    // email. Approvers mark a sender trusted (drops the "new sender" flag) or
    // blocked (agent ignores their mail). The agent reads this with the Admin SDK.
    match /social_senders/{email} {
      allow read: if isSocialApprover();
      allow create, update: if isSocialApprover()
        && request.resource.data.keys().hasOnly(['email', 'status', 'by', 'at'])
        && request.resource.data.status in ['trusted', 'blocked']
        && request.resource.data.email == email;
      allow delete: if isSocialApprover();
    }

    // ---- Admin: edit log. Any signed-in board member's actions create
    // entries; only the super-admin list can read them back. ----
    match /activity_log/{id} {
      allow create: if isAdmin();
      allow read: if isSuperAdmin();
    }

    // ---- Attendance (kids' data) ----
    // Keep in sync with SESSIONS in checkin.html / attendance-tracker.html.
    function validSession(d) {
      return d in ['test',
        '2026-10-11','2026-10-18','2026-10-25','2026-11-01','2026-11-08',
        '2026-11-15','2026-11-22','2026-11-29','2026-12-06','2026-12-13',
        '2027-01-10','2027-01-17','2027-01-24','2027-01-31','2027-02-07',
        '2027-02-14','2027-02-21','2027-02-28','2027-03-07','2027-03-21'];
    }

    // Parents can look up ONE child by exact name key; nobody but admins can list.
    match /checkin_roster/{key} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // Parents can create a check-in for a rostered child, once per session.
    match /checkins/{id} {
      allow get: if true;
      allow list, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['key', 'sessionDate', 'method', 'checkedInAt'])
        && request.resource.data.method == 'qr'
        && request.resource.data.checkedInAt == request.time
        && validSession(request.resource.data.sessionDate)
        && id == request.resource.data.sessionDate + '__' + request.resource.data.key
        && exists(/databases/$(database)/documents/checkin_roster/$(request.resource.data.key))
      );
    }

    // "My child isn't listed" — parents can submit, only admins can read.
    match /checkin_walkins/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['childName', 'parentName', 'phone', 'program', 'sessionDate', 'createdAt'])
        && request.resource.data.childName is string && request.resource.data.childName.size() >= 2 && request.resource.data.childName.size() <= 80
        && request.resource.data.parentName is string && request.resource.data.parentName.size() >= 2 && request.resource.data.parentName.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 7 && request.resource.data.phone.size() <= 30
        && request.resource.data.program in ['Not sure', 'Learn 2 Skate', 'Future Stars']
        && request.resource.data.createdAt == request.time
        && validSession(request.resource.data.sessionDate)
      );
    }
  }
}
